# AutomationKit - environment sample
# Copy to .env, or just run start.ps1 which generates one for you.
# Never commit the real .env file.

POSTGRES_USER=autokit
POSTGRES_PASSWORD=CHANGE_ME_PLEASE
POSTGRES_DB=autokit

# n8n encrypts every stored credential with this key.
# If you lose it, all saved credentials become unreadable.
# Any random string of 32+ characters works.
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM

# Timezone used by schedule triggers and log timestamps.
GENERIC_TIMEZONE=Asia/Shanghai
